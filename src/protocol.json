{
  "message_rules": [
    {
      "from_role": "Patient",
      "direct_to_roles": [
        "CareProvider",
        "Guardian"
      ]
    },
    {
      "from_role": "CareProvider",
      "can_create_groups": true,
      "direct_to_roles": [
        "Patient",
        "Guardian"
      ],
      "group_member_roles": [
        "Patient",
        "Guardian"
      ]
    },
    {
      "from_role": "Guardian",
      "can_create_groups": true,
      "direct_to_roles": [
        "CareProvider",
        "Patient"
      ],
      "group_member_roles": [
        "CareProvider",
        "Patient"
      ]
    }
  ],
  "home": {
    "element": {
      "type": "ref",
      "path": "home_${role}.json"
    }
  },
  "connections": {
    "type": "ref",
    "path": "connections_${role}.json"
  }
}